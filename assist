
-- AimGui > LocalScript
-- Smooth aim-assist for your own Roblox shooter

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local gui = script.Parent
gui.ResetOnSpawn = false

local headlockEnabled = false
local aimEnabled = false

local SMOOTHNESS = 5
local MAX_DISTANCE = 250
local FOV_PIXELS = 180

local function createButton(name, text, position)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Text = text
    button.Size = UDim2.fromOffset(190, 42)
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 16
    button.Parent = gui
    return button
end

local headButton = createButton(
    "HeadlockButton",
    "Headlock: OFF",
    UDim2.new(0, 20, 0, 100)
)

local aimButton = createButton(
    "AimbotButton",
    "Aim Assist: OFF",
    UDim2.new(0, 20, 0, 150)
)

headButton.Activated:Connect(function()
    headlockEnabled = not headlockEnabled
    headButton.Text = "Headlock: "
        .. (headlockEnabled and "ON" or "OFF")
end)

aimButton.Activated:Connect(function()
    aimEnabled = not aimEnabled
    aimButton.Text = "Aim Assist: "
        .. (aimEnabled and "ON" or "OFF")
end)

local function getTarget()
    local bestHead = nil
    local bestScreenDistance = FOV_PIXELS
    local viewport = camera.ViewportSize
    local screenCenter = Vector2.new(
        viewport.X / 2,
        viewport.Y / 2
    )

    for _, target in Players:GetPlayers() do
        if target ~= player and target.Character then
            local character = target.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local head = character:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and head then
                local distance =
                    (head.Position - camera.CFrame.Position).Magnitude

                if distance <= MAX_DISTANCE then
                    local screenPos, visible =
                        camera:WorldToViewportPoint(head.Position)

                    if visible and screenPos.Z > 0 then
                        local screenDistance = (
                            Vector2.new(screenPos.X, screenPos.Y)
                            - screenCenter
                        ).Magnitude

                        if screenDistance < bestScreenDistance then
                            bestScreenDistance = screenDistance
                            bestHead = head
                        end
                    end
                end
            end
        end
    end

    return bestHead
end

RunService:BindToRenderStep(
    "SmoothAimAssist",
    Enum.RenderPriority.Camera.Value + 1,
    function(dt)
        if not aimEnabled or not headlockEnabled then
            return
        end

        local head = getTarget()
        if not head or not head.Parent then
            return
        end

        local origin = camera.CFrame.Position
        local direction = head.Position - origin

        if direction.Magnitude == 0 then
            return
        end

        local targetCFrame = CFrame.lookAt(origin, head.Position)

        -- Frame-rate-independent smooth interpolation
        local alpha = 1 - math.exp(-SMOOTHNESS * dt)

        camera.CFrame = camera.CFrame:Lerp(
            targetCFrame,
            alpha
        )
    end
)
